# Airlock API — Production Environment Variables
# Set these in Railway (or your hosting provider) dashboard.

# ── Required ─────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASS@HOST:5432/airlock
REDIS_URL=redis://HOST:6379/0
JWT_SECRET=                          # >= 32 chars, generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=                # Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Domain / WebAuthn ────────────────────────────────────────────────────────
APP_URL=https://brainbrigade.xyz
RP_ID=brainbrigade.xyz
RP_NAME=Brain Brigade
RP_ORIGIN=https://brainbrigade.xyz

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Brain Brigade <noreply@brainbrigade.xyz>

# ── Search (MeiliSearch) ────────────────────────────────────────────────────
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=                    # Generate: openssl rand -hex 16

# ── AI / LLM ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
LITELLM_API_BASE=http://litellm:4000
LITELLM_MASTER_KEY=
