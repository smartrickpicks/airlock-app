{
  "name": "airlock",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:api": "cd apps/api && pytest tests/ -v",
    "test:e2e": "pnpm --filter @airlock/web test:e2e",
    "test:e2e:ui": "pnpm --filter @airlock/web test:e2e:ui",
    "test:e2e:update": "pnpm --filter @airlock/web test:e2e:update",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yaml}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6",
    "@commitlint/config-conventional": "^19.6",
    "husky": "^9.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5",
    "turbo": "^2.4"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "version": "1.0.0",
  "description": "Enterprise data operations platform. Discord-like interface for contract lifecycle management.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "dependencies": {
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.23",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-module-utils": "^2.12.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0-canary-7118f5dd7-20230705",
    "eslint-scope": "^7.2.2",
    "eslint-visitor-keys": "^3.4.3"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
